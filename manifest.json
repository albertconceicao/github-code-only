{
  "manifest_version": 3,
  "name": "GitHub Code Only",
  "short_name": "Code Only",
  "version": "1.0.9",
  "description": "On GitHub PR review, dim tests, ADRs, specs, and AI-generated files so only real code stays in focus.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "GitHub Code Only",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["src/matcher.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "github-code-only@local",
      "strict_min_version": "121.0"
    }
  }
}
